{
  "buildCommand": "echo 'Building static game'",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/sound/(.*)",
      "headers": [
        {
          "key": "Accept-Ranges",
          "value": "bytes"
        },
        {
          "key": "Content-Type",
          "value": "audio/mpeg"
        }
      ]
    }
  ]
}
